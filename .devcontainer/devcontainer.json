{
  "name": "Litestar development",
  "dockerComposeFile": "compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/litestar-base",
  "shutdownAction": "stopCompose",
  "remoteUser": "vscode",
  "postCreateCommand": "uv sync --locked",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "Litestar app",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "settings": {
        "explorer.excludeGitIgnore": true,
        "python.analysis.extraPaths": ["${workspaceFolder}/apps/service"],
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff",
          "editor.formatOnSave": true,
          "editor.codeActionsOnSave": {
            "source.fixAll.ruff": "explicit",
            "source.organizeImports.ruff": "explicit"
          }
        },
        "mypy-type-checker.importStrategy": "fromEnvironment",
        "python.defaultInterpreterPath": "/home/vscode/.venvs/litestar-base/bin/python"
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",
        "ms-python.mypy-type-checker"
      ]
    }
  }
}
